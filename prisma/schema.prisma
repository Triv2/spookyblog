// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {

  provider = "cockroachdb"

  url      = env("DATABASE_URL")

}


model Profile {
  id            String @id @default(uuid())
  clerkId String
  userName String
}

model Comment {
  id            String @id @default(uuid())
  clerkId String
}

model Author {
  id            String @id @default(uuid())
  clerkId String
  userName String
}

model Category {
  id            String @id @default(uuid())
}

model SubCategory {
  id            String @id @default(uuid())
}

model Post {
  id            String @id @default(uuid())
}